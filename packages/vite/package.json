{
  "name": "@themeon/vite",
  "version": "0.0.0",
  "description": "Vite plugin for ThemeOn: a virtual:themeon.css module with HMR (hotUpdate) and an optional generated anti-FOUC script — for Laravel/plain (non-Nuxt) projects.",
  "keywords": [
    "design-tokens",
    "theming",
    "vite",
    "vite-plugin",
    "dark-mode",
    "design-system"
  ],
  "homepage": "https://github.com/themeon/themeon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themeon/themeon.git",
    "directory": "packages/vite"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. --project @themeon/vite"
  },
  "dependencies": {
    "@themeon/core": "workspace:*",
    "@themeon/vue": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^7 || ^8"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
