{
  "name": "@themeon/css",
  "version": "0.0.0",
  "description": "CSS foundation for ThemeOn: @layer cascade, reset, base typography, layout composition, site blueprints and component skeletons on CSS custom properties.",
  "keywords": [
    "design-tokens",
    "css",
    "css-layer",
    "layout",
    "design-system"
  ],
  "homepage": "https://github.com/axiomasoft/themeon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axiomasoft/themeon.git",
    "directory": "packages/css"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": ["**/*.css"],
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./index.css": "./dist/index.css",
    "./layers.css": "./dist/layers.css",
    "./layers-tailwind.css": "./dist/layers-tailwind.css",
    "./reset.css": "./dist/reset.css",
    "./base.css": "./dist/base.css",
    "./composition.css": "./dist/composition.css",
    "./blueprints.css": "./dist/blueprints.css",
    "./components.css": "./dist/components.css",
    "./utilities.css": "./dist/utilities.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "tsdown && node scripts/build.mjs && node scripts/gen-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. --project @themeon/css"
  },
  "dependencies": {},
  "devDependencies": {
    "@themeon/colors": "workspace:*",
    "@themeon/core": "workspace:*",
    "@types/node": "catalog:",
    "lightningcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
