{
  "name": "@themeon/core",
  "version": "0.0.0",
  "description": "Typed design-token engine: TS tokens → CSS custom properties (build + runtime), naming engine and DTCG interchange. Zero runtime dependencies.",
  "keywords": [
    "design-tokens",
    "css-variables",
    "theming",
    "dtcg",
    "design-system"
  ],
  "homepage": "https://github.com/axiomasoft/themeon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axiomasoft/themeon.git",
    "directory": "packages/core"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./authoring": {
      "types": "./dist/public/authoring.d.ts",
      "import": "./dist/public/authoring.js"
    },
    "./compiler": {
      "types": "./dist/public/compiler.d.ts",
      "import": "./dist/public/compiler.js"
    },
    "./runtime": {
      "types": "./dist/public/runtime.d.ts",
      "import": "./dist/public/runtime.js"
    },
    "./dtcg": {
      "types": "./dist/public/dtcg.d.ts",
      "import": "./dist/public/dtcg.js"
    },
    "./tenant": {
      "types": "./dist/public/tenant.d.ts",
      "import": "./dist/public/tenant.js"
    }
  },
  "typesVersions": {
    "*": {
      "authoring": ["./dist/public/authoring.d.ts"],
      "compiler": ["./dist/public/compiler.d.ts"],
      "runtime": ["./dist/public/runtime.d.ts"],
      "dtcg": ["./dist/public/dtcg.d.ts"],
      "tenant": ["./dist/public/tenant.d.ts"]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. --project @themeon/core",
    "test:property": "vitest run --root ../.. --project @themeon/core src/property"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@terrazzo/parser": "catalog:",
    "colorjs.io": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "fast-check": "catalog:"
  }
}
