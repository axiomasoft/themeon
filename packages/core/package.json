{
  "name": "@themeon/core",
  "version": "0.0.0",
  "description": "Typed design-token engine: TS tokens → CSS custom properties (build + runtime), naming engine and DTCG interchange. Zero runtime dependencies.",
  "keywords": [
    "design-tokens",
    "css-variables",
    "theming",
    "dtcg",
    "design-system"
  ],
  "homepage": "https://github.com/themeon/themeon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themeon/themeon.git",
    "directory": "packages/core"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. --project @themeon/core"
  },
  "devDependencies": {
    "@terrazzo/parser": "catalog:",
    "colorjs.io": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
