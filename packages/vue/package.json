{
  "name": "@themeon/vue",
  "version": "0.0.0",
  "description": "Reactive theme switching for Vue: useTheme() (persist, prefers-color-scheme, N themes), a Vue plugin and a generated anti-FOUC script — on top of @themeon/core.",
  "keywords": [
    "design-tokens",
    "theming",
    "vue",
    "dark-mode",
    "design-system"
  ],
  "homepage": "https://github.com/themeon/themeon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themeon/themeon.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./anti-fouc": {
      "types": "./dist/anti-fouc.d.ts",
      "import": "./dist/anti-fouc.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. --project @themeon/vue"
  },
  "dependencies": {
    "@themeon/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
