{
  "name": "@themeon/naive",
  "version": "0.0.0",
  "description": "Naive UI adapter: toNative(resolved) builds a GlobalThemeOverrides object (hex/rgba colours, self-derived hover/pressed/suppl states) plus a deep-merge and breakpoint-aware overrides resolver — on top of @themeon/core.",
  "keywords": [
    "design-tokens",
    "naive-ui",
    "theming",
    "design-system"
  ],
  "homepage": "https://github.com/axiomasoft/themeon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axiomasoft/themeon.git",
    "directory": "packages/naive"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. --project @themeon/naive"
  },
  "dependencies": {
    "@themeon/colors": "workspace:*",
    "@themeon/core": "workspace:*",
    "colorjs.io": "catalog:"
  },
  "peerDependencies": {
    "naive-ui": "^2.44",
    "vue": "^3.5"
  },
  "devDependencies": {
    "naive-ui": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
