# AI-agent tooling — machine-local state and per-developer harness wiring.
# Hooks are shims into an absolute path on one workstation (fail-closed for
# everyone else), memory/state/lease files are per-session churn. Shared,
# portable agent config (CLAUDE.md, .serena/project.yml, .swissknife.json)
# stays tracked.
.cursor/logs/
.cursor/state/
.cursor/hooks.json
.cursor/hooks/
.cursor/memory.env.ini
.claude/memory.env.ini
.claude/settings.local.json
.codex/hooks.json
.codex/hooks/
.codex/state/
.swissknifeman/

node_modules
dist
.nuxt
coverage
.stryker-tmp
mutation/mutation-report.json
benchmarks/last-report.json
*.tsbuildinfo
.tmp-*
.tmp-consumer-packs
.tmp-api-packs
.tmp-types-cells
tests/consumers/.tmp-cells
tests/consumers/node_modules
tests/fixtures/generated/replay/*-[0-9]*.json
docs/.vitepress/cache/
docs/.vitepress/dist/
.mcp.json
.cursor/mcp.json
.codex/config.toml
