{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/hooks/lifecycle.py\" --surface lifecycle.memory"
      }
    ],
    "afterShellExecution": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/hooks/lifecycle.py\" --surface lifecycle.command-log"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/hooks/lifecycle.py\" --surface security.safe-dirs",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/hooks/lifecycle.py\" --surface lifecycle.tool-telemetry"
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 \"${CURSOR_PROJECT_DIR:-.}/.cursor/hooks/lifecycle.py\" --surface lifecycle.run-report"
      }
    ]
  }
}
